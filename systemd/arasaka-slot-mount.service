[Unit]
Description=Arasaka A/B Slot Mount
DefaultDependencies=no
After=local-fs-pre.target
Before=local-fs.target
Wants=local-fs.target
# The A/B squashfs machinery is inactive until the first update creates
# /boot/ab/arasaka-rootfs.sfs. On a fresh raw-slot install the kernel mounts
# the ext4 root directly, so this service must no-op.
ConditionPathExists=/boot/ab/arasaka-rootfs.sfs

[Service]
Type=oneshot
ExecStart=/usr/local/bin/arasaka-slot-mount.sh
RemainAfterExit=yes

[Install]
WantedBy=local-fs.target

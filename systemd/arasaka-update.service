[Unit]
Description=Arasaka Signed OTA Update
Documentation=https://github.com/arasaka
After=network-online.target systemd-resolved.service rauc.service
Wants=network-online.target
ConditionPathExists=!/var/lock/arasaka-update.lock

[Service]
Type=oneshot
ExecStartPre=/usr/bin/mkdir -p /var/lock
ExecStartPre=/usr/bin/touch /var/lock/arasaka-update.lock
ExecStart=/usr/local/bin/arasaka-ota-update.sh
ExecStartPost=/usr/bin/rm -f /var/lock/arasaka-update.lock
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ReadWritePaths=/var/tmp /var/cache /var/log /tmp /run /boot /data
PrivateTmp=true
NoNewPrivileges=false
RestrictRealtime=false

[Install]
WantedBy=multi-user.target

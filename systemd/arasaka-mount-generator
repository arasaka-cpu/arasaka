#!/usr/bin/env bash
# arasaka-mount-generator
# systemd system-generator that detects active A/B slot and sets up mounts.
# Placed in /etc/systemd/system-generators/
set -euo pipefail

GENERATOR_DIR="${1:-/run/systemd/generator}"
SLOT_FILE="/boot/ab/active-slot"
ROOTFS_IMG="/boot/ab/arasaka-rootfs.sfs"

mkdir -p "${GENERATOR_DIR}"

detect_slot() {
    if [ -f "$SLOT_FILE" ]; then
        cat "$SLOT_FILE"
    else
        echo "a"
    fi
}

generate_mount_units() {
    # On a fresh install there is no A/B squashfs image yet (the active slot is
    # a plain ext4 partition mounted directly by the kernel). Only emit the
    # sysroot.mount unit once an updated rootfs image actually exists.
    if [ ! -f "$ROOTFS_IMG" ]; then
        return 0
    fi

    local slot
    slot=$(detect_slot)

    # Mount unit for the squashfs root. The unit filename MUST match the mount
    # point (Where=) -- systemd derives the mount path from the unit name, so
    # a unit called arasaka-root.mount with Where=/sysroot is refused.
    cat > "${GENERATOR_DIR}/sysroot.mount" << EOF
[Unit]
Description=Arasaka Immutable Root (Slot ${slot})
DefaultDependencies=no
After=local-fs-pre.target

[Mount]
What=${ROOTFS_IMG}
Where=/sysroot
Type=squashfs
Options=ro,loop
EOF

    # Generator wants this mount
    mkdir -p "${GENERATOR_DIR}/local-fs.target.wants"
    ln -sf "../sysroot.mount" "${GENERATOR_DIR}/local-fs.target.wants/sysroot.mount"
}

generate_slot_info() {
    local slot
    slot=$(detect_slot)

    cat > "${GENERATOR_DIR}/arasaka-slot-info.conf" << EOF
# Generated by arasaka-mount-generator
# Active slot: ${slot}
SLOT=${slot}
EOF
}

main() {
    mkdir -p "${GENERATOR_DIR}"
    generate_mount_units
    generate_slot_info
}

main "$@"
